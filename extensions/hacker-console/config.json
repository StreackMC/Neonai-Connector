{
  // ── 监听 ───────────────────────────────────────────────────────────────
  // 只绑回环地址。这个页面能执行任意代码，**不要**改成 0.0.0.0 或局域网 IP。
  "host": "127.0.0.1",
  "port": 4780,
  // 访问令牌；留空表示不校验。非空时页面需用 http://127.0.0.1:4780/?token=xxx 打开。
  "token": "",

  // ── 身份 ───────────────────────────────────────────────────────────────
  // 以谁的身份调用 aicode。它同时决定两件事：
  //   1) aicode 的权限校验（默认需要 aicode.execute）
  //   2) aicode 的并发分组（同一执行者同时只跑一个任务）
  "executor": "$console",
  // aicode 需要的权限名。仅在 autoGrant 生效时用于「自动授予/回收」。
  "permission": "aicode.execute",
  // 被 aicode 以 permission_denied 拒绝时，自动给上面的 executor 授予上面的权限并重试一次；
  // 拓展关闭时回收（只回收自己授出去的那一份）。
  "autoGrant": true,

  // 请求体上限（字节）。aicode 自己另有 maxCodeBytes 限制。
  "maxBodyBytes": 1048576
}
