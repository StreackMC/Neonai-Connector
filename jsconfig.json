{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "main.js",
    "src/**.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}