{
  // 机器人名称
  "name": "澪奈",
  // 机器人次要名称（部分场景会使用）
  "subname": "Neonai",
  // 命令前缀，消息 trimStart 后匹配任一即触发命令解析
  "prefix": ["/", "~", "／", "～"],
  // 日志大小达到多少就压缩
  "maxLogFileSize": 1048576,
  // 日志是否要全量记录，为 false 时会自动压缩
  "detailedLog": true,
  // 控制 AI 回复设置
  "ai": {
    // 是否接受优化用户输入
    // 这可能带来额外开销，也可能会带来额外收益
    "acceptOptimizingPrompt": true,
    // 如果要优化用户输入，使用哪些 AI Profile ；设为 "*" 表示全部
    "model2Optimize": ["*"],
  },
}