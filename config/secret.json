// 本文件是项目敏感配置文件，编辑无效
// 需要复制本文件到项目根目录才可生效
{
  // 配置 OpenAI 格式的 AI API Key
  "oai": [
    {
      // Profile 名称
      // 也对应了 /config/prompts/ 下的 .md 文件，用于控制 AI 初始提示词
      // 原则上所有 Profile 名称都不应该使用特殊字符，包含空格等，否则会引起意料之外的错误
      "name": "deepseek",
      // 是否允许非管理员使用
      "available": true,
      // API 地址（Base URL，不含端点路径，由 SDK 自动拼接 /chat/completions 或 /responses）
      "address": "https://api.deepseek.com/v1",
      // 秘钥
      "token": "sk-1234567890",
      // 使用的模型
      "model": "deepseek-v4-flash",
      // 是否使用 ResponseAPI（/responses 端点）；false 则使用 Chat Completions（/chat/completions）
      "responseAPI": false,
      // 是否启用流式响应
      "stream": false,
      // 此 Profile 可调用的 AI 工具：
      //   空 / 未设置 → 不得调用任何工具
      //   "*" → 全部工具
      //   "!tool" → 屏蔽特定工具（支持模糊匹配）
      //   "ns:tool" → 精确匹配命名空间限定工具；"tool" → 模糊匹配任意命名空间下的同名工具
      "tools": ["*"]
    }
  ],
  // 配置平台
  "platforms": [
    {
      // Profile 名称
      "name": "qqbot",
      // 在运行时自动启动吗
      "enabled": true,
      // 官方QQBOT
      "type": "qqbot",
      // 下面的值填写官网的
      "appid": "123456789",
      "appsecret": "kfc_fkxq4_vivo50",
      // 最大重试次数
      "maxRetry": 3,
      // 是否允许使用 AI 回复未知的命令
      // 请注意官bot不允许使用AIGC回复，自行承担风险
      "useAI": false,
      // 控制可以使用哪些 AIProfile ，"*"表示全部
      // 会按顺序尝试
      "allowedAI": ["*"]
    }
  ]
}