// 本文件是项目敏感配置文件，编辑无效
// 需要复制本文件到项目根目录才可生效
{
  // 配置 OpenAI 格式的 AI API Key
  "oai": [
    {
      // Profile 名称
      // 也对应了 /config/prompts/ 下的 .md 文件，用于控制 AI 初始提示词
      "name": "deepseek",
      // 是否允许非管理员使用
      "available": true,
      // API 地址
      "address": "https://api.deepseek.com",
      // 秘钥
      "token": "sk-1234567890",
      // 使用的模型
      "model": "deepseek-v4-flash"
    }
  ],
  // 配置平台
  "platforms": [
    {
      // Profile 名称
      "name": "qqbot",
      // 在运行时自动启动吗
      "enabled": true,
      // 官方QQBOT
      "type": "qqbot",
      // 下面的值填写官网的
      "appid": "123456789",
      "appsecret": "kfc_fkxq4_vivo50",
      // 最大重试次数
      "maxRetry": 3
    }
  ]
}