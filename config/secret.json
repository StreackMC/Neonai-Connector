// 本文件是项目敏感配置文件，编辑无效
// 需要复制本文件到项目根目录才可生效
{
  // 配置 OpenAI 格式的 AI API Key
  "oai": [
    {
      // Profile 名称
      // 原则上所有 Profile 名称都不应该使用特殊字符，包含空格等，否则会引起意料之外的错误
      "name": "deepseek",
      // 禁用后只能通过命令调用
      "available": true,
      // API 基础地址（base URL，需自己包含 /v1 这类前缀）
      "address": "https://api.deepseek.com/v1/",
      // 秘钥
      "token": "sk-1234567890",
      // 使用的模型
      "model": "deepseek-v4-flash",
      // 请求体格式：false → Chat Completions，true → Responses API
      "responseAPI": false,
      // 是否启用流式响应
      "stream": false,
      // 此 Profile 可调用的 AI 工具（"*" 为通配符，命名空间与工具名两段都可以写）：
      //   空 / 未设置 → 不得调用任何工具
      //   "*" → 全部工具
      //   "ns:tool" → 精确匹配该工具；"ns:*" → 该命名空间下的全部工具
      //   "tool"（省略命名空间）等价于 "*:tool" → 任意命名空间下的同名工具
      //   "!xxx" → 排除，排除优先于纳入（如 "!ns:*" 屏蔽整个命名空间）
      "tools": ["*"],
      // 交由 Provider 服务端执行的工具（Provider Held Tools），与上面的 tools 相互独立：
      //   键名：webSearch / webSearchPreview / codeInterpreter / fileSearch / imageGeneration / mcp
      //         （也接受下划线写法如 "web_search"，大小写与 _ - 均不敏感）
      //   值：true → 用该工具的默认参数；对象 → 原样透传给该工具（如 { "searchContextSize": "medium" }）；
      //       false / null → 显式关闭；数组 → 构造多实例（如挂多个 mcp server）
      //   也可写成数组简写 ["webSearch", "codeInterpreter"]
      // ⚠️ 仅 Responses API 支持，必须同时 responseAPI: true；配置了却走 Chat Completions 会直接报错
      // ⚠️ 该服务是否真的实现了对应内置工具由 address 决定，第三方兼容端点通常没有
      "providerTools": {},
      // 请求体里额外声明的工具（给"兼容 OpenAI 协议、但有自己内置工具类型"的第三方平台用）：
      //   键 = 请求体里该条目的 type，值 = 该条目的其余字段（true / {} 表示只有 type）
      //   例：{ "deepseek_web_search": true } → 请求体 tools 里追加 { "type": "deepseek_web_search" }
      //       { "deepseek_web_search": { "mode": "fast" } } → 追加 { "type": "deepseek_web_search", "mode": "fast" }
      //   值写数组 → 注入多条；写 false / null → 跳过
      // ⚠️ 这类工具 AI SDK 不认识，只能由服务端执行（结果直接写进回复）。
      //    若平台返回 tool_call 要求客户端执行，会报 NoSuchToolError——那种情况请注册本地工具。
      // ⚠️ 与 tools 里的本地工具是两个世界：它不会出现在本地工具表里，也不受 tools 过滤。
      "extraTools": {},
      // AI 工具调用最大轮次：每轮模型可执行一次工具调用并取回结果，
      // 数值越大模型能完成的多步任务越多，但耗时也越长（默认 5 轮）。
      "maxToolcall": 5,
      // 要使用的提示词文件，相对于 /config/prompts ，安全起见不能脱离父路径
      "prompt": "neonai.md",
      // 多模态配置
      "mutimodal": {
        // 图片视觉，后接可理解的图片 MIME
        "image": ["image/gif", "image/png", "image/jpg"],
        // 视频视觉
        "video": [],
        // 音频
        "audio": []
      }
    }
  ],
  // 配置聊天平台
  "platforms": [
    {
      // Profile 名称
      "name": "qqbot",
      // 在运行时自动启动吗
      "enabled": true,
      // 官方QQBOT
      "type": "qqbot",
      // 下面的值填写官网的
      "appid": "123456789",
      "appsecret": "kfc_fkxq4_vivo50",
      // 最大重试次数
      "maxRetry": 3,
      // 是否允许使用 AI 回复未知的命令
      // 请注意官bot不允许使用AIGC回复，自行承担风险
      "useAI": false,
      // 控制可以使用哪些 AIProfile ，"*"表示全部
      // 会按顺序尝试
      "allowedAI": ["*"],
      // ── AI Profile 路由 ──────────────────────────────────────────
      // 按上下文选择可用的 AI Profile。规则自上而下匹配，首条命中即用；
      // 都没命中（或本数组为空）则沿用上面的 allowedAI —— 默认行为与以前完全一致。
      //
      // when 各字段之间为 AND，字段内的数组为 OR。支持：
      //   scene       'private' | 'group'
      //   group       'GRP#<群号>'
      //   user        'USR#<QQ号>'
      //   permission  权限名，可列多个（须全部具备）；按整条执行者链判定，群级授权同样生效
      //   match       消息文本正则（默认 flags 'i'，可用 flags 覆盖）
      // use 里的 "*" 表示「沿用 allowedAI」，路由不会越过平台白名单。
      //
      // ⚠️ 尝试顺序恒等于 secret.json.oai 的声明顺序，use 只决定「用哪几个」，
      //    因此 use: ["A","B"] 不能表达「A 优先、失败退到 B」。
      // ⚠️ available: false 的 Profile 会被 askAI 静默跳过，路由到它等于没路由
      //    （先用 /neonaic:ai profile enable <name> 启用）。
      "aiRouting": [
        // { "when": { "permission": "admin" },        "use": ["deepseek"] },
        // { "when": { "scene": "private" },           "use": ["*"] },
        // { "when": { "match": "代码|报错|堆栈|异常" }, "use": ["deepseek"] },
      ]
    }
  ]
}